{"ast":null,"code":"import SurveyService from \"@/services/SurveyService\";\nexport default {\n  name: \"SurveyList\",\n  data() {\n    return {\n      surveys: []\n    };\n  },\n  methods: {\n    fetchSurveys() {\n      SurveyService.getAll().then(res => {\n        this.surveys = res.data;\n      }).catch(err => console.error(err));\n    },\n    deleteSurvey(id) {\n      SurveyService.delete(id).then(() => this.fetchSurveys()).catch(err => console.error(err));\n    }\n  },\n  mounted() {\n    this.fetchSurveys();\n  }\n};","map":{"version":3,"names":["SurveyService","name","data","surveys","methods","fetchSurveys","getAll","then","res","catch","err","console","error","deleteSurvey","id","delete","mounted"],"sources":["/Users/amlanchowdhury/SWE645hw3/survey-vue-client/src/components/survey/SurveyList.vue"],"sourcesContent":["<template>\n  <div>\n    <h2>All Surveys</h2>\n    <button @click=\"fetchSurveys\">Refresh List</button>\n    <ul v-if=\"surveys.length\">\n      <li v-for=\"survey in surveys\" :key=\"survey.id\">\n        <strong>{{ survey.firstName }} {{ survey.lastName }}</strong>\n        <br />\n        <router-link :to=\"`/surveys/${survey.id}`\">View</router-link> |\n        <router-link :to=\"`/edit/${survey.id}`\">Edit</router-link> |\n        <button @click=\"deleteSurvey(survey.id)\">Delete</button>\n      </li>\n    </ul>\n    <div v-else>No surveys found.</div>\n    <router-link to=\"/create\">+ Create New Survey</router-link>\n  </div>\n</template>\n\n<script>\nimport SurveyService from \"@/services/SurveyService\";\n\nexport default {\n  name: \"SurveyList\",\n  data() {\n    return {\n      surveys: [],\n    };\n  },\n  methods: {\n    fetchSurveys() {\n      SurveyService.getAll()\n        .then((res) => {\n          this.surveys = res.data;\n        })\n        .catch((err) => console.error(err));\n    },\n    deleteSurvey(id) {\n      SurveyService.delete(id)\n        .then(() => this.fetchSurveys())\n        .catch((err) => console.error(err));\n    },\n  },\n  mounted() {\n    this.fetchSurveys();\n  },\n};\n</script>\n"],"mappings":"AAmBA,OAAOA,aAAY,MAAO,0BAA0B;AAEpD,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,YAAYA,CAAA,EAAG;MACbL,aAAa,CAACM,MAAM,CAAC,EAClBC,IAAI,CAAEC,GAAG,IAAK;QACb,IAAI,CAACL,OAAM,GAAIK,GAAG,CAACN,IAAI;MACzB,CAAC,EACAO,KAAK,CAAEC,GAAG,IAAKC,OAAO,CAACC,KAAK,CAACF,GAAG,CAAC,CAAC;IACvC,CAAC;IACDG,YAAYA,CAACC,EAAE,EAAE;MACfd,aAAa,CAACe,MAAM,CAACD,EAAE,EACpBP,IAAI,CAAC,MAAM,IAAI,CAACF,YAAY,CAAC,CAAC,EAC9BI,KAAK,CAAEC,GAAG,IAAKC,OAAO,CAACC,KAAK,CAACF,GAAG,CAAC,CAAC;IACvC;EACF,CAAC;EACDM,OAAOA,CAAA,EAAG;IACR,IAAI,CAACX,YAAY,CAAC,CAAC;EACrB;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}