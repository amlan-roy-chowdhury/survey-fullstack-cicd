{"ast":null,"code":"import SurveyService from '@/services/SurveyService';\nexport default {\n  name: 'SurveyDetail',\n  data() {\n    return {\n      survey: null\n    };\n  },\n  created() {\n    const id = this.$route.params.id;\n    SurveyService.get(id).then(res => {\n      this.survey = res.data;\n    }).catch(err => console.error(err));\n  }\n};","map":{"version":3,"names":["SurveyService","name","data","survey","created","id","$route","params","get","then","res","catch","err","console","error"],"sources":["/Users/amlanchowdhury/SWE645hw3/survey-vue-client/src/components/survey/SurveyDetail.vue"],"sourcesContent":["<template>\n  <div v-if=\"survey\">\n    <h2>Survey Details</h2>\n    <p><strong>Name:</strong> {{ survey.firstName }} {{ survey.lastName }}</p>\n    <p><strong>Email:</strong> {{ survey.email }}</p>\n    <p><strong>City/State:</strong> {{ survey.city }}, {{ survey.state }}</p>\n    <p><strong>Recommendation:</strong> {{ survey.recommendation }}</p>\n    <p><strong>Interest:</strong> {{ survey.interest }}</p>\n    <p><strong>Likings:</strong> {{ survey.likings }}</p>\n    <router-link to=\"/\">← Back</router-link>\n  </div>\n</template>\n\n<script>\nimport SurveyService from '@/services/SurveyService';\n\nexport default {\n  name: 'SurveyDetail',\n  data() {\n    return {\n      survey: null,\n    };\n  },\n  created() {\n    const id = this.$route.params.id;\n    SurveyService.get(id)\n      .then((res) => {\n        this.survey = res.data;\n      })\n      .catch((err) => console.error(err));\n  },\n};\n</script>\n\n"],"mappings":"AAcA,OAAOA,aAAY,MAAO,0BAA0B;AAEpD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE;IACV,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,EAAC,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACF,EAAE;IAChCL,aAAa,CAACQ,GAAG,CAACH,EAAE,EACjBI,IAAI,CAAEC,GAAG,IAAK;MACb,IAAI,CAACP,MAAK,GAAIO,GAAG,CAACR,IAAI;IACxB,CAAC,EACAS,KAAK,CAAEC,GAAG,IAAKC,OAAO,CAACC,KAAK,CAACF,GAAG,CAAC,CAAC;EACvC;AACF,CAAC","ignoreList":[]}