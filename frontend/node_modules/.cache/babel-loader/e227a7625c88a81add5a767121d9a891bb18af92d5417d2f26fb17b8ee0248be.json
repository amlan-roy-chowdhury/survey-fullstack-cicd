{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport SurveyService from \"@/services/SurveyService\";\nexport default {\n  name: \"SurveyForm\",\n  data() {\n    return {\n      survey: {\n        firstName: \"\",\n        lastName: \"\",\n        email: \"\",\n        address: \"\",\n        city: \"\",\n        state: \"\",\n        zip: \"\",\n        telephone: \"\",\n        dateOfSurvey: \"\",\n        recommendation: \"\",\n        interest: \"\",\n        likings: \"\"\n      }\n    };\n  },\n  computed: {\n    isEdit() {\n      return !!this.$route.params.id;\n    }\n  },\n  created() {\n    if (this.isEdit) {\n      SurveyService.get(this.$route.params.id).then(res => {\n        this.survey = res.data;\n      });\n    }\n  },\n  methods: {\n    handleSubmit() {\n      if (this.isEdit) {\n        SurveyService.update(this.$route.params.id, this.survey).then(() => {\n          this.$router.push(\"/\");\n        });\n      } else {\n        SurveyService.create(this.survey).then(() => {\n          this.$router.push(\"/\");\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["SurveyService","name","data","survey","firstName","lastName","email","address","city","state","zip","telephone","dateOfSurvey","recommendation","interest","likings","computed","isEdit","$route","params","id","created","get","then","res","methods","handleSubmit","update","$router","push","create"],"sources":["/Users/amlanchowdhury/SWE645hw3/survey-vue-client/src/components/survey/SurveyForm.vue"],"sourcesContent":["<template>\n  <div>\n    <h2>{{ isEdit ? \"Edit\" : \"Create\" }} Survey</h2>\n    <form @submit.prevent=\"handleSubmit\">\n      <label>First Name: <input v-model=\"survey.firstName\" required /></label\n      ><br />\n      <label>Last Name: <input v-model=\"survey.lastName\" required /></label\n      ><br />\n      <label>Email: <input v-model=\"survey.email\" required /></label><br />\n      <label>Address: <input v-model=\"survey.address\" required /></label><br />\n      <label>City: <input v-model=\"survey.city\" required /></label><br />\n      <label>State: <input v-model=\"survey.state\" required /></label><br />\n      <label>Zip: <input v-model=\"survey.zip\" required /></label><br />\n      <label>Telephone: <input v-model=\"survey.telephone\" required /></label\n      ><br />\n      <label\n        >Date of Survey:\n        <input v-model=\"survey.dateOfSurvey\" type=\"date\" required /></label\n      ><br />\n      <label\n        >Recommendation:\n        <select v-model=\"survey.recommendation\">\n          <option>Very Likely</option>\n          <option>Likely</option>\n          <option>Unlikely</option>\n        </select> </label\n      ><br />\n      <label\n        >Interest:\n        <select v-model=\"survey.interest\">\n          <option>Friends</option>\n          <option>Television</option>\n          <option>Internet</option>\n          <option>Other</option>\n        </select> </label\n      ><br />\n      <label\n        >Likings:\n        <select v-model=\"survey.likings\">\n          <option>Students</option>\n          <option>Location</option>\n          <option>Campus</option>\n          <option>Atmosphere</option>\n          <option>Dorm Rooms</option>\n          <option>Sports</option>\n        </select> </label\n      ><br />\n      <button type=\"submit\">{{ isEdit ? \"Update\" : \"Submit\" }}</button>\n    </form>\n  </div>\n</template>\n\n<script>\nimport SurveyService from \"@/services/SurveyService\";\n\nexport default {\n  name: \"SurveyForm\",\n  data() {\n    return {\n      survey: {\n        firstName: \"\",\n        lastName: \"\",\n        email: \"\",\n        address: \"\",\n        city: \"\",\n        state: \"\",\n        zip: \"\",\n        telephone: \"\",\n        dateOfSurvey: \"\",\n        recommendation: \"\",\n        interest: \"\",\n        likings: \"\",\n      },\n    };\n  },\n  computed: {\n    isEdit() {\n      return !!this.$route.params.id;\n    },\n  },\n  created() {\n    if (this.isEdit) {\n      SurveyService.get(this.$route.params.id).then((res) => {\n        this.survey = res.data;\n      });\n    }\n  },\n  methods: {\n    handleSubmit() {\n      if (this.isEdit) {\n        SurveyService.update(this.$route.params.id, this.survey).then(() => {\n          this.$router.push(\"/\");\n        });\n      } else {\n        SurveyService.create(this.survey).then(() => {\n          this.$router.push(\"/\");\n        });\n      }\n    },\n  },\n};\n</script>\n"],"mappings":";AAqDA,OAAOA,aAAY,MAAO,0BAA0B;AAEpD,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE;QACNC,SAAS,EAAE,EAAE;QACbC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,OAAO,EAAE,EAAE;QACXC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,GAAG,EAAE,EAAE;QACPC,SAAS,EAAE,EAAE;QACbC,YAAY,EAAE,EAAE;QAChBC,cAAc,EAAE,EAAE;QAClBC,QAAQ,EAAE,EAAE;QACZC,OAAO,EAAE;MACX;IACF,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,MAAMA,CAAA,EAAG;MACP,OAAO,CAAC,CAAC,IAAI,CAACC,MAAM,CAACC,MAAM,CAACC,EAAE;IAChC;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,IAAI,CAACJ,MAAM,EAAE;MACfjB,aAAa,CAACsB,GAAG,CAAC,IAAI,CAACJ,MAAM,CAACC,MAAM,CAACC,EAAE,CAAC,CAACG,IAAI,CAAEC,GAAG,IAAK;QACrD,IAAI,CAACrB,MAAK,GAAIqB,GAAG,CAACtB,IAAI;MACxB,CAAC,CAAC;IACJ;EACF,CAAC;EACDuB,OAAO,EAAE;IACPC,YAAYA,CAAA,EAAG;MACb,IAAI,IAAI,CAACT,MAAM,EAAE;QACfjB,aAAa,CAAC2B,MAAM,CAAC,IAAI,CAACT,MAAM,CAACC,MAAM,CAACC,EAAE,EAAE,IAAI,CAACjB,MAAM,CAAC,CAACoB,IAAI,CAAC,MAAM;UAClE,IAAI,CAACK,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC;QACxB,CAAC,CAAC;MACJ,OAAO;QACL7B,aAAa,CAAC8B,MAAM,CAAC,IAAI,CAAC3B,MAAM,CAAC,CAACoB,IAAI,CAAC,MAAM;UAC3C,IAAI,CAACK,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC;QACxB,CAAC,CAAC;MACJ;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}